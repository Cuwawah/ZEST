generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  businessName String?
  slug         String   @unique
  timezone     String   @default("Africa/Lagos")
  bufferTime   Int      @default(0)
  minNotice    Int      @default(24)
  plan              String   @default("free")
  trialEndsAt       DateTime?
  paymentRef        String?
  paymentAmountKobo Int?
  planExpiresAt     DateTime?
  sentReminders     String?
  renewalNoticeDismissedAt DateTime?
  phone             String?
  logoUrl      String?
  accentColor  String?
  hideBranding Boolean  @default(false)
  profileSlug  String?  @unique
  bio          String?
  website      String?
  socialLinks  String?
  coverImage   String?
  referralCode String?  @unique
  referredById String?
  referredBy   User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals    User[]   @relation("Referrals")
  createdAt    DateTime @default(now())

  eventTypes        EventType[]
  paymentMatches    PaymentTransaction[]
  clients           Client[]
  clientTags        ClientTag[]
}

model EventType {
  id          String   @id @default(cuid())
  name        String
  description String?
  duration    Int
  slug        String
  userId      String
  isActive    Boolean  @default(true)
  views       Int      @default(0)
  capacity    Int      @default(1)
  reminderHours Int    @default(24)
  createdAt   DateTime @default(now())

  user              User               @relation(fields: [userId], references: [id])
  availabilityRules AvailabilityRule[]
  intakeQuestions   IntakeQuestion[]
  bookings          Booking[]

  @@unique([slug])
  @@index([userId])
}

model AvailabilityRule {
  id          String  @id @default(cuid())
  eventTypeId String
  type        String
  dayOfWeek   Int?
  date        String?
  everyNDays  Int?
  dayOfMonth  Int?
  startTime   String
  endTime     String
  isAvailable Boolean

  eventType EventType @relation(fields: [eventTypeId], references: [id])

  @@index([eventTypeId])
}

model IntakeQuestion {
  id          String  @id @default(cuid())
  eventTypeId String
  order       Int
  type        String
  label       String
  required    Boolean @default(false)
  options     String?

  eventType EventType @relation(fields: [eventTypeId], references: [id])
  responses Response[]

  @@index([eventTypeId])
}

model Booking {
  id          String   @id @default(cuid())
  eventTypeId String
  clientId    String?
  clientName  String
  clientEmail String
  phone       String?
  startTime   DateTime
  endTime     DateTime
  status      String   @default("confirmed")
  notes       String?
  reminderSentAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime @default(now())

  eventType EventType @relation(fields: [eventTypeId], references: [id])
  client    Client?   @relation(fields: [clientId], references: [id])
  responses Response[]

  @@index([eventTypeId])
  @@index([clientId])
}

model Response {
  id         String        @id @default(cuid())
  bookingId  String
  questionId String
  answer     String

  booking  Booking       @relation(fields: [bookingId], references: [id])
  question IntakeQuestion @relation(fields: [questionId], references: [id])

  @@index([bookingId])
  @@index([questionId])
}

model Client {
  id        String   @id @default(cuid())
  userId    String
  name      String?
  email     String
  phone     String?
  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id])
  bookings Booking[]
  tags     ClientTagAssignment[]

  @@unique([userId, email])
  @@index([userId])
}

model ClientTag {
  id     String @id @default(cuid())
  userId String
  name   String
  color  String @default("#f5c518")

  user    User        @relation(fields: [userId], references: [id])
  clients ClientTagAssignment[]

  @@unique([userId, name])
  @@index([userId])
}

model ClientTagAssignment {
  id       String @id @default(cuid())
  clientId String
  tagId    String

  client Client    @relation(fields: [clientId], references: [id])
  tag    ClientTag @relation(fields: [tagId], references: [id])

  @@unique([clientId, tagId])
  @@index([clientId])
  @@index([tagId])
}

model PaymentTransaction {
  id            String   @id @default(cuid())
  messageId     String   @unique
  sender        String?
  receivedAt    DateTime?
  amountKobo    Int?
  senderName    String?
  narration     String?
  rawBody       String?
  refMatch      String?
  status        String   @default("parsed")
  matchedUserId String?
  matchedUser   User?    @relation(fields: [matchedUserId], references: [id])
  createdAt     DateTime @default(now())

  @@index([status])
  @@index([matchedUserId])
}
